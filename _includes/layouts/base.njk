<!doctype html>
<html lang="{{ metadata.language }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		{%- set pageTitle = metadata.title + " - " + title if title else metadata.title %}
		{%- set pageDescription = description or metadata.description %}
		{%- set pageUrl = metadata.origin + page.url %}

		<title>{{ pageTitle }}</title>
		<meta name="description" content="{{ pageDescription }}">
		<link rel="canonical" href="{{ pageUrl }}">

		{#- Open Graph and Twitter cards, so a link to the group looks like
		    something when it is shared rather than a bare URL. #}
		<meta property="og:type" content="website">
		<meta property="og:site_name" content="{{ metadata.title }}">
		<meta property="og:title" content="{{ pageTitle }}">
		<meta property="og:description" content="{{ pageDescription }}">
		<meta property="og:url" content="{{ pageUrl }}">
		<meta property="og:image" content="{{ metadata.origin }}/images/logos/nlp-tlp-logo.png">
		<meta name="twitter:card" content="summary">
		<meta name="twitter:title" content="{{ pageTitle }}">
		<meta name="twitter:description" content="{{ pageDescription }}">

		<link rel="shortcut icon" href="/images/favicon.ico">

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

		{%- css %}* { box-sizing: border-box; }{% endcss %}
		{%- css %}{% include "public/css/index.css" %}{% endcss %}
		<style>{% getBundle "css" %}</style>

		{#- Tells search engines that this is a research organisation and who
		    is in it. Without it the group's name is just words on a page. #}
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "ResearchOrganization",
			"name": "UWA NLP-TLP Group",
			"alternateName": "Centre for Natural and Technical Language Processing",
			"url": "{{ metadata.url }}",
			"logo": "{{ metadata.origin }}/images/logos/nlp-tlp-logo.png",
			"parentOrganization": {
				"@type": "CollegeOrUniversity",
				"name": "The University of Western Australia",
				"url": "https://www.uwa.edu.au/"
			},
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Perth",
				"addressRegion": "WA",
				"addressCountry": "AU"
			}
		}
		</script>
	</head>
	<body>
		<a href="#skip" class="visually-hidden">Skip to main content</a>

		{% include 'partials/header.njk' %}

		{% include 'partials/hero.njk' %}

		{% if wide %}
			<div class="container padded-v-4x">
				<main id="skip">
				{{ content | safe }}
				</main>
			</div>
		{% else %}
			<div class="container main-flex-container flex-container padded-v-4x">
				{% include 'partials/sidenav.njk' %}
				<main class="padded margin-left-3x" id="skip">
				{{ content | safe }}
				</main>
			</div>
		{% endif %}

		{% include 'partials/footer.njk' %}

		<!-- This page `{{ page.url | htmlBaseUrl }}` was built on {% currentBuildDate %} -->
	</body>
</html>
