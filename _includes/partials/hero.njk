{#- The hero carries the group's identity on the home page, and the name of
    the current page everywhere else, so the page heading is not repeated
    immediately below it. #}
<div id="hero" class="flex-container flex-align-center box-shadow-inset hero-background {% if not full_hero %}hero-condensed{% endif %}">
    <div class="hero-background"></div>
    <div class="container flex-container flex-align-center">
      {% if full_hero %}
      <div class="hero-text">
        <h2>The University of Western Australia</h2>
        <h1>Natural &amp; Technical Language Processing Group</h1>
      </div>
      {% else %}
      <div class="hero-text hero-text-page">
        <h1>{{ title }}</h1>
      </div>
      {% endif %}
    </div>
</div>
