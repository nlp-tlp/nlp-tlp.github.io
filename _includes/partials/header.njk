{%- set navPages = collections.all | eleventyNavigation(navItem) %}
<header class="header">
    <div class="container flex-container flex-align-center justify-space-between">

      {#- The whole lockup is the home link, which is what people reach for.
          UWA itself is linked from the footer. #}
      <a href="/" class="header-left flex-container flex-align-center" aria-label="UWA NLP-TLP Group home">
        <span class="logo">
          <img src="/images/logos/uwacrest-blue.png" alt="The University of Western Australia" />
        </span>
        <span class="logo nlp-tlp-logo header-mark">
          <img src="/images/logos/nlp-tlp-logo.png" alt="NLP-TLP"/>
        </span>
      </a>

      <nav class="topnav" aria-label="Main">
        <ul>
          {% for entry in navPages %}
            <li><a href="{{ entry.url }}"{% if entry.url == page.url or entry.url == page.url | getbase %} class="active" aria-current="page"{% endif %}>{{ entry.title }}</a></li>
          {% endfor %}
          <li><a href="https://github.com/nlp-tlp/" target="_blank" rel="noopener">GitHub<svg class="external-mark" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true" focusable="false"><path d="M3 1h6v6M9 1 1 9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
        </ul>
      </nav>
    </div>
</header>
